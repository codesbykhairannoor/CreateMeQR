{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "createmy-qr.com"
        }
      ],
      "destination": "https://www.createmy-qr.com/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.createmy-qr.com/llms.txt>; rel=\"llms-txt\""
        }
      ]
    }
  ]
}